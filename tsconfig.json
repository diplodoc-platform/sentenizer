{
  "extends": "@diplodoc/infra/tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2019"],
    "target": "es6",
    "rootDir": "src",
    "outDir": "lib/",
    "module": "node16",
    "moduleResolution": "node16",
    "paths": {
      "src/*": ["./src/*"],
      "__tests__/*": ["./__tests__/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "src/playground.ts"]
}
